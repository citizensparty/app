# Optional settings for the host. Put a file named .env next to the program; everything has a default.
# Never share data/host.key or HOST_SECRET.

# A friendly name shown to members
HOST_NAME=Citizens Party host

# How members reach this host. By default the host starts a free Cloudflare quick tunnel by itself
# (no account; the address changes on each restart and the host announces the new one).
# For a fixed address, make a tunnel in the Cloudflare dashboard (Zero Trust > Networks > Tunnels),
# point its public hostname at http://localhost:7447, and fill in both of these:
TUNNEL_TOKEN=
RELAY_URL=
# Or, if you already have your own address (Caddy, nginx...), set RELAY_URL and TUNNEL=off.
# TUNNEL=off

# Built into the program; only set these to override.
# OWNER_PUBKEYS=
# PEERS=
# PORT=7447
# DATA_DIR=data
